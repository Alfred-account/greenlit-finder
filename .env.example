# Airtable — server-side only (не VITE_, ключ не должен попадать в браузер)
# На Vercel: Project Settings → Environment Variables (Production + Preview), затем Redeploy.

AIRTABLE_API_KEY=pat...          # Personal Access Token с правами data.records:read и data.records:write
AIRTABLE_BASE_ID=app...          # ID базы (из URL: airtable.com/appXXXXXXXX/...)
AIRTABLE_TABLE_NAME=Opportunities # опционально, по умолчанию "Opportunities"
